# Copy to .env for local development. All of these have safe dev-mode
# fallbacks (in-memory Mongo, mock checkout) except where noted, so the app
# runs without any of this being set — but production needs real values.

# MongoDB Atlas connection string. If unset, an in-memory MongoDB is used for
# local dev only (data is lost on restart).
MONGODB_URI=

# Secret used to sign login sessions. If unset, an insecure dev-only default
# is used — MUST be set in production.
JWT_SECRET=

# Default admin account created on first run if it doesn't exist yet.
ADMIN_EMAIL=admin@norwoodgas.local
ADMIN_PASSWORD=ChangeMe123!

# Stripe (test mode keys are fine while developing). If unset, checkout runs
# in a local dev-only mode that marks orders paid without charging a card.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Public base URL used to build Stripe success/cancel links. Optional locally
# (inferred from the request); set this in production.
APP_URL=

# Vercel Blob storage token, used for admin-uploaded product images. If unset,
# uploads are written to public/uploads/ on local disk instead — fine for
# local dev, but that does NOT persist on Vercel's serverless filesystem, so
# this must be set in production (create a Blob store in your Vercel project
# settings to get a token).
BLOB_READ_WRITE_TOKEN=
